<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#f26f1d">
  <meta name="description" content="BrewTon Cafe — 100% Pure Veg cafe in Hisar. Fresh pizzas, burgers, pasta, shakes, coffee and more.">
  <meta name="color-scheme" content="light">
  <title>BrewTon Cafe — Pure Veg. Full Flavour.</title>
  <link rel="preload" as="image" href="images/veg-single.webp" fetchpriority="high">
  <link rel="stylesheet" href="style.css?v=200">
</head>
<body>
  <div class="page-glow" aria-hidden="true"></div>
  <div class="scroll-line" id="scrollLine" aria-hidden="true"></div>

  <header class="site-header" id="siteHeader">
    <a class="brand" href="#home" aria-label="BrewTon Cafe home">
      <span class="brand-mark">B</span>
      <span class="brand-copy"><strong>BrewTon</strong><small>CAFE</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#menu">Menu</a><a href="#story">Our Story</a><a href="#contact">Visit Us</a>
    </nav>
    <button class="cart-pill" id="cartButton" type="button" aria-label="Open cart">
      <span>Cart</span><b id="cartCount">0</b>
    </button>
  </header>

  <main id="home">
    <section class="hero section-shell">
      <div class="hero-copy">
        <div class="eyebrow">100% PURE VEG <i>·</i> HISAR</div>
        <h1>Made for<br><em>slow sips</em><br>&amp; big bites.</h1>
        <p class="hero-lead">A warm corner for bold pizzas, silky shakes and coffee that keeps the conversation going.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#menu">Explore the menu <span>↗</span></a>
          <a class="btn btn-link" href="tel:9468068043">Call us</a>
        </div>
        <div class="hero-note"><span>✦</span> Wheat Base Pizza <i>·</i> Crafted fresh, always</div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-halo"></div><div class="art-ring ring-a"></div><div class="art-ring ring-b"></div>
        <div class="pizza-orb"><div class="pizza-cheese"><i></i><i></i><i></i><i></i><b></b></div></div>
        <div class="floating-card mood-card"><small>Today's mood</small><strong>Cheesy<br>and easy.</strong></div>
        <div class="floating-card hours-card"><small>OPEN DAILY</small><strong>10:00 AM — 10:00 PM</strong></div>
        <span class="spark spark-a">✦</span><span class="spark spark-b">✧</span>
      </div>
    </section>

    <div class="ticker" aria-label="BrewTon highlights">
      <div class="ticker-track"><span>PURE VEG</span><i>✦</i><span>FRESHLY MADE</span><i>✦</i><span>WHEAT BASE PIZZA</span><i>✦</i><span>GOOD MOOD FOOD</span><i>✦</i><span>PURE VEG</span><i>✦</i><span>FRESHLY MADE</span><i>✦</i><span>WHEAT BASE PIZZA</span></div>
    </div>

    <section class="menu-section section-shell" id="menu">
      <div class="menu-top">
        <div>
          <div class="eyebrow">THE GOOD STUFF</div>
          <h2>Pick your<br><em>pleasure.</em></h2>
        </div>
        <div class="menu-intro"><span id="menuItemCount">0</span> delicious choices<br><small>Made fresh to order</small></div>
      </div>

      <div class="menu-controls">
        <label class="search-box"><span>⌕</span><input id="search" type="search" autocomplete="off" placeholder="Search pizzas, burgers, coffee..." aria-label="Search menu"><button id="clearSearch" type="button" aria-label="Clear search">×</button></label>
        <div class="chips" id="chips" role="tablist" aria-label="Menu categories"></div>
      </div>

      <div id="menuContent" aria-live="polite"></div>
    </section>

    <section class="story" id="story">
      <div class="story-inner section-shell">
        <div class="story-copy">
          <div class="eyebrow">WHY BREWTON</div>
          <h2>More than<br>a <em>cafe.</em></h2>
          <p>Fresh ingredients, generous flavours and a place that feels like your favourite playlist. Every order is prepared with the same simple idea: make it worth the bite.</p>
          <div class="signature">BrewTon <span>♥</span></div>
        </div>
        <div class="story-facts">
          <div><b>01</b><strong>Pure Veg</strong><span>Nothing but good stuff.</span></div>
          <div><b>02</b><strong>Wheat Base</strong><span>Our signature pizza touch.</span></div>
          <div><b>03</b><strong>Made Fresh</strong><span>Order-by-order love.</span></div>
        </div>
      </div>
    </section>

    <section class="contact section-shell" id="contact">
      <div><div class="eyebrow">COME SAY HI</div><h2>Your table<br>is <em>waiting.</em></h2></div>
      <div class="contact-card">
        <p>Gali Number 1, HTM Colony,<br>Azad Nagar, Hisar, Haryana 125007</p>
        <p><strong>10:00 AM — 10:00 PM</strong><br>Every day</p>
        <div class="contact-actions"><a href="tel:9468068043">9468068043</a><a href="https://wa.me/918950386412" target="_blank" rel="noopener">WhatsApp us ↗</a></div>
      </div>
    </section>
  </main>

  
<footer class="brewton-final-footer">
  <div class="brewton-footer-glow"></div>

  <div class="brewton-footer-inner">

    <div class="brewton-footer-brand">
      <div class="brewton-footer-logo">B</div>
      <div>
        <div class="brewton-footer-name">BrewTon</div>
        <div class="brewton-footer-cafe">CAFE</div>
      </div>
    </div>

    <div class="brewton-footer-tag">
      100% PURE VEG · FRESHLY MADE · WHEAT BASE PIZZA
    </div>

    <div class="brewton-footer-title">
      Come, have a bite. ☕
    </div>

    <div class="brewton-footer-grid">

      <div class="brewton-footer-box">
        <span class="brewton-footer-icon">📍</span>
        <div>
          <b>Visit Us</b>
          <p>Gali Number 1, HTM Colony,<br>
          Azad Nagar, Hisar,<br>
          Haryana 125007</p>
        </div>
      </div>

      <div class="brewton-footer-box">
        <span class="brewton-footer-icon">🕐</span>
        <div>
          <b>Opening Hours</b>
          <p>Every Day<br>
          <strong>10:00 AM — 10:00 PM</strong></p>
        </div>
      </div>

      <div class="brewton-footer-box">
        <span class="brewton-footer-icon">📱</span>
        <div>
          <b>Order / Contact</b>
          <p>9468068043</p>
          <a href="https://wa.me/919468068043" target="_blank" rel="noopener">
            WhatsApp Us ↗
          </a>
        </div>
      </div>

    </div>

    <div class="brewton-footer-pills">
      <span>✦ PURE VEG</span>
      <span>✦ FRESHLY MADE</span>
      <span>✦ GOOD MOOD FOOD</span>
    </div>

    <div class="brewton-footer-bottom">
      <span>© 2026 BrewTon Cafe · Hisar</span>
      <span>Made with good vibes ✦</span>
    </div>

  </div>
</footer>


  <div class="backdrop" id="backdrop"></div>

  <aside class="cart-drawer" id="cartDrawer" aria-hidden="true" aria-label="Shopping cart">
    <div class="drawer-head"><div><div class="eyebrow">YOUR ORDER</div><h3>Good choices.</h3></div><button class="icon-close" id="closeCart" type="button" aria-label="Close cart">×</button></div>
    <div id="cartItems" class="cart-items"></div>
    <div class="cart-footer"><div class="total-row"><span>Total</span><strong id="cartTotal">₹0</strong></div><button class="btn btn-primary full" id="checkout" type="button">Order on WhatsApp <span>↗</span></button></div>
  </aside>

  <div class="modal-layer" id="itemModal" aria-hidden="true">
    <div class="modal-card item-modal-card" role="dialog" aria-modal="true" aria-labelledby="itemModalTitle">
      <button class="icon-close modal-close" data-close="itemModal" type="button" aria-label="Close">×</button>
      <div id="itemModalContent"></div>
    </div>
  </div>

  <div class="modal-layer" id="orderTypeModal" aria-hidden="true">
    <div class="modal-card order-modal-card" role="dialog" aria-modal="true" aria-labelledby="orderTypeTitle">
      <div class="eyebrow">ORDER TYPE</div><h3 id="orderTypeTitle">How should we serve you?</h3><p class="modal-sub">Choose one option to continue.</p>
      <div class="order-options">
        <button type="button" data-order-type="Take Away"><span>🛵</span><b>Delivery</b><small>We'll deliver it fresh.</small></button>
        <button type="button" data-order-type="Pickup"><span>🏠</span><b>Pickup</b><small>Ready when you arrive.</small></button>
        <button type="button" data-order-type="Dine-in"><span>🍽️</span><b>Dine-in</b><small>Enjoy it at the cafe.</small></button>
      </div>
    </div>
  </div>

  <div class="modal-layer" id="customerModal" aria-hidden="true">
    <div class="modal-card customer-card" role="dialog" aria-modal="true" aria-labelledby="customerTitle">
      <button class="icon-close modal-close" data-close="customerModal" type="button" aria-label="Close">×</button>
      <div class="eyebrow">CUSTOMER DETAILS</div><h3 id="customerTitle">A few details.</h3><p class="modal-sub">Enter the details needed for your order.</p>
      <div class="form-grid">
        <label>Name<input id="customerName" type="text" autocomplete="name" placeholder="Your name"></label>
        <label>Phone<input id="customerPhone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="10" placeholder="10 digit mobile number"></label>
        <label id="addressWrap">Address<textarea id="customerAddress" rows="3" autocomplete="street-address" placeholder="Your delivery address or landmark"></textarea><button id="useLocationBtn" class="location-btn" type="button">📍 Use My Current Location</button><small id="locationStatus"></small></label>
        <label>Special Note <span style="font-weight:500;text-transform:none;letter-spacing:0;color:#9a8178;">(Optional)</span><textarea id="customerNote" rows="3" placeholder="e.g. Onion mat dalna, less spicy, extra cheese..."></textarea></label>
      </div>
      <button class="btn btn-primary full" id="continueCustomerDetails" type="button">Continue to WhatsApp <span>→</span></button>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script src="script.js?v=99999999" defer></script>
</body>
</html>
