/* Deep cinematic café base */
body{
  background-color:#120704!important;
  background-image:
    radial-gradient(circle at 50% 18%,rgba(173,76,25,.28),transparent 30%),
    radial-gradient(circle at 8% 42%,rgba(244,119,33,.14),transparent 20%),
    radial-gradient(circle at 92% 55%,rgba(244,119,33,.14),transparent 20%),
    linear-gradient(90deg,#090403 0%,#241008 18%,#35170b 50%,#241008 82%,#090403 100%)!important;
  background-attachment:fixed!important;
}

/* Warm café food decoration around the content */
body::before{
  content:"";
  position:fixed;
  inset:0;
  z-index:-2;
  pointer-events:none;
  background:
    linear-gradient(90deg,rgba(7,3,2,.18),transparent 20%,transparent 80%,rgba(7,3,2,.20)),
    url("images/family-pizza.webp") left -75px 18% / 210px auto no-repeat,
    url("images/brewton-special-burger.webp") right -70px 36% / 215px auto no-repeat,
    url("images/cappuccino-coffee.webp") left -45px 72% / 185px auto no-repeat,
    url("images/cheese-loaded-fries.webp") right -45px 79% / 185px auto no-repeat,
    radial-gradient(circle at 12% 20%,rgba(255,174,74,.20) 0 3px,transparent 5px),
    radial-gradient(circle at 89% 27%,rgba(255,174,74,.22) 0 3px,transparent 5px),
    radial-gradient(circle at 7% 62%,rgba(255,150,45,.18) 0 3px,transparent 5px),
    radial-gradient(circle at 94% 68%,rgba(255,150,45,.18) 0 3px,transparent 5px);
  filter:saturate(1.05) contrast(1.05);
  animation:brewtonCinematicGlow 12s ease-in-out infinite alternate;
}

/* Dark center + golden vignette */
body::after{
  content:"";
  position:fixed;
  inset:0;
  z-index:-1;
  pointer-events:none;
  background:
    radial-gradient(ellipse at center,rgba(8,3,2,.05) 20%,rgba(8,3,2,.42) 100%),
    linear-gradient(90deg,rgba(5,2,1,.42),transparent 25%,transparent 75%,rgba(5,2,1,.44)),
    linear-gradient(180deg,rgba(5,2,1,.18),transparent 18%,transparent 82%,rgba(5,2,1,.38));
}

/* Subtle moving golden atmosphere */
@keyframes brewtonCinematicGlow{
  0%{transform:scale(1);opacity:.72}
  50%{transform:scale(1.025);opacity:.88}
  100%{transform:scale(1.01);opacity:.76}
}

/* Let cinematic background remain visible */
main,
.menu-section,
.menu-container,
.menu-page,
.items,
.category-block{
  background:transparent!important;
}

/* Café-style section headings */
.category-block h2,
.category-block h3,
.category-title{
  color:#fff7ed!important;
  text-shadow:
    0 2px 10px rgba(0,0,0,.75),
    0 0 24px rgba(244,119,33,.18)!important;
}

/* Orange item count */
.category-block .item-count,
.category-block .count,
.category-block small{
  color:#f47721!important;
}

/* Keep cards above decoration */
.item-card{
  position:relative!important;
  z-index:2!important;
}

/* Desktop decoration */
@media(min-width:701px){
  body::before{
    background:
      linear-gradient(90deg,rgba(7,3,2,.18),transparent 20%,transparent 80%,rgba(7,3,2,.20)),
      url("images/family-pizza.webp") left 15px 20% / 250px auto no-repeat,
