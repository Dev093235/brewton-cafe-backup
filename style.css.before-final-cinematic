  }
}

/* Android: food stays at edges, never covers cards */
@media(max-width:700px){
  body{
    background-attachment:scroll!important;
    background-image:
      radial-gradient(circle at 50% 18%,rgba(173,76,25,.30),transparent 32%),
      radial-gradient(circle at 0 55%,rgba(244,119,33,.12),transparent 22%),
      radial-gradient(circle at 100% 65%,rgba(244,119,33,.12),transparent 22%),
      linear-gradient(90deg,#100604,#32160b 50%,#100604)!important;
  }

  body::before{
    background:
      url("images/family-pizza.webp") left -105px 31% / 170px auto no-repeat,
      url("images/brewton-special-burger.webp") right -105px 47% / 175px auto no-repeat,
      url("images/cappuccino-coffee.webp") left -80px 76% / 155px auto no-repeat,
