/* Warm animated background */
body{
  overflow-x:hidden;
  background:
    radial-gradient(circle at 88% 12%,rgba(244,119,33,.14),transparent 25%),
    radial-gradient(circle at 5% 65%,rgba(244,119,33,.10),transparent 25%),
    var(--paper);
}

/* Floating menu cards */
.item-card{
  animation:brewtonFloat 4s ease-in-out infinite !important;
  transform:translateY(0);
  will-change:transform;
}

.item-card:nth-child(2n){
  animation-delay:-2s !important;
}

@keyframes brewtonFloat{
  0%,100%{
    transform:translateY(0);
  }
  50%{
    transform:translateY(-8px);
  }
}

/* Strong hover movement */
.item-card:hover{
  animation-play-state:paused !important;
  transform:translateY(-12px) scale(1.012) !important;
  transition:transform .3s ease,box-shadow .3s ease;
  box-shadow:0 22px 45px rgba(48,25,17,.18);
}

/* Image zoom */
.item-card .item-photo{
  transition:transform .55s cubic-bezier(.2,.8,.2,1);
}

.item-card:hover .item-photo{
  transform:scale(1.045);
}

/* Moving light */
.item-card{
  position:relative;
  overflow:hidden;
}

.item-card::after{
  content:"";
  position:absolute;
  top:-30%;
  left:-80%;
  width:30%;
  height:160%;
  pointer-events:none;
  z-index:20;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.28),transparent);
  transform:rotate(18deg);
  animation:brewtonShine 6s ease-in-out infinite;
}

@keyframes brewtonShine{
  0%,65%{left:-80%;opacity:0}
  72%{opacity:1}
  88%,100%{left:145%;opacity:0}
}

@media(max-width:560px){
  .item-card{
    animation-duration:4.5s !important;
  }

  .item-card:hover{
    transform:translateY(-5px) scale(1.005) !important;
  }
}

@media(prefers-reduced-motion:reduce){
  .item-card,
  .item-card::after{
    animation:none !important;
  }
}
/* BREWTON DIAGONAL + TEXT FINAL */

.item-card{
  animation:brewtonDiagonal 5s ease-in-out infinite !important;
  will-change:transform;
  transform-origin:center;
}

.item-card:nth-child(2n){
  animation-delay:-2.5s !important;
}

@keyframes brewtonDiagonal{
  0%,100%{transform:translate3d(0,0,0) rotate(0deg)}
  25%{transform:translate3d(5px,-6px,0) rotate(.35deg)}
  50%{transform:translate3d(0,-10px,0) rotate(0deg)}
