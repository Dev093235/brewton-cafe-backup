const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));

let cafe = {}, menu = [], cart = [], activeCategory = 'All', selectedItem = null, selectedOrderType = '', customerLocation = '';
const CART_KEY = 'brewton_cart_v2';

function money(n){ return `₹${Number(n).toLocaleString('en-IN')}`; }
function itemIsPizza(item){ return item.small !== undefined; }
function itemInfo(item){ return item.ingredients?.length ? item.ingredients.join(' · ') : (item.options?.length ? item.options.join(' · ') : (item.quantity || 'Freshly prepared')); }

async function boot(){
  try{
    const res = await fetch('menu.json', {cache:'no-store'});
    if(!res.ok) throw new Error('menu.json failed');
    const data = await res.json();
    cafe = data.cafe || {};
    menu = data.menu || [];
    cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    setup();
  }catch(err){
    console.error(err);
    $('#menuContent').innerHTML = '<div class="no-results">Menu load nahi ho paya.<br>Please refresh the page.</div>';
  }
}

function setup(){
  $('#menuItemCount').textContent = menu.reduce((n,g)=>n+g.items.length,0);
  renderChips(); renderMenu(); renderCart();
  $('#search').addEventListener('input', ()=>{ renderMenu(); $('#clearSearch').style.display = $('#search').value ? 'block' : 'none'; });
  $('#clearSearch').addEventListener('click', ()=>{ $('#search').value=''; $('#clearSearch').style.display='none'; renderMenu(); $('#search').focus(); });
  $('#chips').addEventListener('click', e=>{ const b=e.target.closest('.chip'); if(!b)return; activeCategory=b.dataset.cat; $$('.chip').forEach(x=>x.classList.toggle('active',x===b)); renderMenu(); });
  $('#cartButton').addEventListener('click', openCart);
  $('#closeCart').addEventListener('click', closeCart);
  $('#backdrop').addEventListener('click', closeCart);
  $('#checkout').addEventListener('click', checkout);
  $('#orderTypeModal').addEventListener('click', e=>{ const b=e.target.closest('[data-order-type]'); if(b) chooseOrderType(b.dataset.orderType); });
  $('#continueCustomerDetails').addEventListener('click', submitCustomerDetails);
  $('#useLocationBtn').addEventListener('click', getCurrentLocation);
  $$('.modal-close').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeTopLayer(); });
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
}

function renderChips(){
  const cats = ['All', ...menu.map(x=>x.category)];
  $('#chips').innerHTML = cats.map((cat,i)=>`<button class="chip ${i===0?'active':''}" type="button" data-cat="${esc(cat)}" role="tab" aria-selected="${i===0}">${esc(cat)}</button>`).join('');
}

function renderMenu(){
  const q = $('#search').value.trim().toLowerCase();
  const groups = menu.map(g=>({...g,items:g.items.filter(i=>!q || `${i.name} ${g.category} ${(i.ingredients||[]).join(' ')} ${(i.options||[]).join(' ')}`.toLowerCase().includes(q))})).filter(g=>(activeCategory==='All'||g.category===activeCategory)&&g.items.length);
  $('#menuContent').innerHTML = groups.length ? groups.map((g,gi)=>`
    <section class="category-block">
      <div class="category-title"><h3>${esc(g.category)}</h3><span>${String(g.items.length).padStart(2,'0')} ITEMS</span></div>
      <div class="items">${g.items.map((item,i)=>itemCard(item,gi*10+i)).join('')}</div>
    </section>`).join('') : '<div class="no-results">No delicious match found.<br>Try another search.</div>';
  $$('.add-btn').forEach(b=>b.addEventListener('click',()=>openItem(JSON.parse(b.dataset.item))));
  $$('.item-photo').forEach(img=>img.addEventListener('click',()=>openItem(JSON.parse(img.dataset.item))));
}

function itemCard(item, index){
  const pizza=itemIsPizza(item), json=JSON.stringify(item).replace(/'/g,'&#39;');
  const image=item.image ? `<img class="item-photo" src="${esc(item.image)}" alt="${esc(item.name)}" loading="${index<4?'eager':'lazy'}" decoding="async" data-item='${json}' onerror="this.parentElement.classList.add('image-fallback');this.remove()">` : '';
  return `<article class="item-card">
    <div class="item-visual">${image}${item.badge?`<span class="badge">${esc(item.badge)}</span>`:''}</div>
    <div class="item-info"><h4>${esc(item.name)}</h4><div class="ingredients">${esc(itemInfo(item))}</div>
    ${pizza?`<div class="pizza-prices"><div>Small <b>${money(item.small)}</b></div><div>Medium <b>${money(item.medium)}</b></div><button class="add-btn" type="button" data-item='${json}'>Add to order</button></div>`:
    `<div class="price-line"><span class="price">${money(item.price)}</span><button class="add-btn" type="button" data-item='${json}'>Add</button></div>`}</div>
  </article>`;
}

function openItem(item){
  selectedItem=item;
  let html=`<div class="eyebrow">MAKE IT YOURS</div><h3 id="itemModalTitle">${esc(item.name)}</h3><p class="modal-sub">Choose your preferred option, then add it to your order.</p>`;
  if(item.small!==undefined) html+=optionGroup('SIZE',[['Small',item.small],['Medium',item.medium]],'size');
  if(item.baked_addon) html+=optionGroup('BAKED OPTION',[['Regular',0],['Baked',item.baked_addon]],'baked');
  if(item.cheese_addon) html+=optionGroup('CHEESE',[['No Cheese',0],['Extra Cheese',item.cheese_addon]],'cheese');
  if(item.ice_cream_addon) html+=optionGroup('ICE CREAM',[['No Ice Cream',0],['With Ice Cream',item.ice_cream_addon]],'ice');
  html+=`<button class="btn btn-primary modal-add" id="modalAdd" type="button">Add to order <span>→</span></button>`;
  $('#itemModalContent').innerHTML=html;
  $('#itemModal').classList.add('show'); $('#itemModal').setAttribute('aria-hidden','false'); document.body.classList.add('modal-open');
  $$('#itemModal .option-buttons').forEach(group=>group.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;group.querySelectorAll('button').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');}));
  $('#modalAdd').addEventListener('click',addSelected);
}
function optionGroup(title,opts,type){return `<div class="option-group"><label>${title}</label><div class="option-buttons">${opts.map((o,i)=>`<button type="button" data-type="${type}" data-value="${esc(o[0])}" data-price="${o[1]}" class="${i===0?'selected':''}">${esc(o[0])}${o[1]?' · '+money(o[1]):''}</button>`).join('')}</div></div>`}

function addSelected(){
  const options=[], selections=$$('#itemModal .option-buttons button.selected');
  let price=selectedItem.price ?? selectedItem.small;
  selections.forEach(b=>{options.push(b.dataset.value); if(b.dataset.type==='size') price=Number(b.dataset.price); else price+=Number(b.dataset.price||0);});
  const key=`${selectedItem.name}|${options.join('|')}`;
  const found=cart.find(x=>x.key===key);
  if(found) found.qty++; else cart.push({key,name:selectedItem.name,options,price,qty:1});
  persistCart(); renderCart(); closeModal('itemModal'); showToast('Added to your order ✓');
}

function persistCart(){ localStorage.setItem(CART_KEY,JSON.stringify(cart)); }
function renderCart(){
  const count=cart.reduce((n,x)=>n+x.qty,0), total=cart.reduce((n,x)=>n+x.price*x.qty,0);
  $('#cartCount').textContent=count; $('#cartTotal').textContent=money(total);
  $('#cartItems').innerHTML=cart.length?cart.map((x,i)=>`<div class="cart-row"><div><h4>${esc(x.name)}</h4><small>${esc(x.options.join(' · ')||'Regular')}</small></div><div class="cart-row-right"><strong>${money(x.price*x.qty)}</strong><div class="quantity"><button type="button" data-action="minus" data-i="${i}">−</button><span>${x.qty}</span><button type="button" data-action="plus" data-i="${i}">+</button></div><button class="remove" type="button" data-action="remove" data-i="${i}">REMOVE</button></div></div>`).join(''):`<div class="empty">Your cart is waiting for something delicious.<br><br>✦</div>`;
  $$('#cartItems [data-action]').forEach(b=>b.addEventListener('click',()=>{const i=Number(b.dataset.i);if(!cart[i])return;if(b.dataset.action==='plus')cart[i].qty++;if(b.dataset.action==='minus')cart[i].qty--;if(b.dataset.action==='remove')cart.splice(i,1);if(cart[i]?.qty<=0)cart.splice(i,1);persistCart();renderCart();}));
}

function openCart(){ $('#cartDrawer').classList.add('open');$('#cartDrawer').setAttribute('aria-hidden','false');$('#backdrop').classList.add('show'); }
function closeCart(){ $('#cartDrawer').classList.remove('open');$('#cartDrawer').setAttribute('aria-hidden','true');if(!$$('.modal-layer.show').length)$('#backdrop').classList.remove('show'); }
function checkout(){ if(!cart.length){showToast('Add something to your order first');return;} $('#orderTypeModal').classList.add('show');$('#orderTypeModal').setAttribute('aria-hidden','false');$('#backdrop').classList.add('show');document.body.classList.add('modal-open'); }
function chooseOrderType(type){ selectedOrderType=type; closeModal('orderTypeModal'); if(type==='Dine-in'){sendWhatsAppOrder(type);return;} $('#customerTitle').textContent=type==='Take Away'?'Delivery details':'Pickup details';$('#addressWrap').style.display=type==='Take Away'?'grid':'none';$('#customerModal').classList.add('show');$('#customerModal').setAttribute('aria-hidden','false'); }

function getCurrentLocation(){
  const status=$('#locationStatus'); if(!navigator.geolocation){status.textContent='Location is not supported on this device.';return;}
  status.textContent='📍 Getting your location...';
  navigator.geolocation.getCurrentPosition(pos=>{customerLocation=`https://www.google.com/maps?q=${pos.coords.latitude},${pos.coords.longitude}`;status.textContent='✓ Location added successfully';$('#useLocationBtn').textContent='✓ Location added';$('#useLocationBtn').classList.add('location-added');},()=>{status.textContent='Unable to get location. Please allow location permission.';},{enableHighAccuracy:true,timeout:15000,maximumAge:0});
}
function submitCustomerDetails(){
  const name=$('#customerName').value.trim(), phone=$('#customerPhone').value.replace(/\D/g,''), address=$('#customerAddress').value.trim(), note=$('#customerNote').value.trim();
  if(!name){showToast('Please enter your name');return;} if(!/^\d{10}$/.test(phone)){showToast('Enter a valid 10 digit phone number');return;} if(selectedOrderType==='Take Away'&&!address&&!customerLocation){showToast('Enter address or use your current location');return;}
  closeModal('customerModal'); sendWhatsAppOrder(selectedOrderType,{name,phone,address,location:customerLocation,note});
}
function sendWhatsAppOrder(orderType,details={}){
  const total = cart.reduce((n,x)=>n + x.price * x.qty, 0);
  const orderId = 'BT-' + Date.now().toString().slice(-6);
  const time = new Date().toLocaleString('en-IN',{
    day:'2-digit',month:'short',year:'numeric',
    hour:'2-digit',minute:'2-digit'
  });

  const items = cart.map((x,i)=>{
    const options = x.options.length
      ? `\n   ↳ ${x.options.join(' • ')}`
      : '';

    return `${i+1}. ${x.name}${options}
   Qty: ${x.qty} × ${money(x.price)} = ${money(x.price*x.qty)}`;
  }).join('\n\n');

  const customer = [
    details.name && `👤 Name: ${details.name}`,
    details.phone && `📞 Phone: ${details.phone}`,
    details.address && `🏠 Address: ${details.address}`,
    details.location && `📍 Location: ${details.location}`,
    details.note && `📝 Note: ${details.note}`
  ].filter(Boolean).join('\n');

  const message = `☕ *BREWTON CAFE*
━━━━━━━━━━━━━━━━━━
🧾 *NEW ORDER RECEIVED*
━━━━━━━━━━━━━━━━━━

🔖 *Order ID:* ${orderId}
🕐 *Time:* ${time}

📦 *ORDER TYPE*
${orderType}

━━━━━━━━━━━━━━━━━━
👤 *CUSTOMER DETAILS*
━━━━━━━━━━━━━━━━━━
${customer || 'Not provided'}

━━━━━━━━━━━━━━━━━━
🍽️ *ORDER SUMMARY*
━━━━━━━━━━━━━━━━━━

${items}

━━━━━━━━━━━━━━━━━━
💰 *TOTAL AMOUNT*
*${money(total)}*
━━━━━━━━━━━━━━━━━━

🔔 *STATUS: NEW ORDER*

❤️ *Thank you for ordering from*
*BrewTon Cafe*

🙏 *Please prepare the order*
━━━━━━━━━━━━━━━━━━`;

  const number = (cafe.whatsapp || '8950386412').replace(/\D/g,'');
  window.location.href =
    `https://wa.me/91${number}?text=${encodeURIComponent(message)}`;
}
function closeModal(id){const el=$(`#${id}`);if(!el)return;el.classList.remove('show');el.setAttribute('aria-hidden','true');if(!$$('.modal-layer.show').length){document.body.classList.remove('modal-open');if(!$('#cartDrawer').classList.contains('open'))$('#backdrop').classList.remove('show');}}
function closeTopLayer(){const open=$$('.modal-layer.show');if(open.length)closeModal(open[open.length-1].id);else closeCart();}
function showToast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>t.classList.remove('show'),1900)}
function onScroll(){const y=window.scrollY, h=document.documentElement.scrollHeight-innerHeight;$('#scrollLine').style.width=(h>0?(y/h)*100:0)+'%';$('#siteHeader').classList.toggle('scrolled',y>8);}

boot();
